    "verify:sales": "node scripts/verify-sales-transaction.mjs",
    "verify:finance": "node scripts/verify-finance-transaction.mjs",
    "verify:golden": "node scripts/verify-golden-path.mjs",
    "verify:guards": "npm run verify:cloud && npm run verify:sri && npm run verify:product && npm run verify:sync && npm run verify:sales && npm run verify:finance && npm run verify:golden",
    "verify": "npm run typecheck && npm run verify:guards"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
