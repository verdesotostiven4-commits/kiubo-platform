{
  "name": "kiubo-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run verify:guards",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify:sri": "node scripts/verify-sri.mjs",
    "verify:cloud": "node scripts/verify-cloud.mjs",
    "verify:product": "node scripts/verify-product-safety.mjs",
    "verify:sync": "node scripts/verify-sync-reliability.mjs",
    "verify:sales": "node scripts/verify-sales-transaction.mjs",
    "verify:reversals": "node scripts/verify-sale-reversal.mjs",
    "verify:finance": "node scripts/verify-finance-transaction.mjs",
    "verify:idempotency": "node scripts/verify-payment-idempotency.mjs",
    "verify:purchases": "node scripts/verify-purchase-transaction.mjs",
    "verify:inventory": "node scripts/verify-inventory-adjustment.mjs",
    "verify:payments": "node scripts/verify-payment-truthfulness.mjs",
    "verify:cashrecon": "node scripts/verify-cash-reconciliation.mjs",
    "verify:food": "node scripts/verify-food-service.mjs",
    "verify:tables": "node scripts/verify-table-isolation.mjs",
    "verify:golden": "node scripts/verify-golden-path.mjs",
    "verify:offline": "node scripts/verify-offline-durability.mjs",
    "verify:pilot": "node scripts/verify-pilot-readiness.mjs",
    "verify:guards": "npm run verify:cloud && npm run verify:sri && npm run verify:product && npm run verify:sync && npm run verify:sales && npm run verify:reversals && npm run verify:finance && npm run verify:idempotency && npm run verify:purchases && npm run verify:inventory && npm run verify:payments && npm run verify:cashrecon && npm run verify:food && npm run verify:tables && npm run verify:golden && npm run verify:offline && npm run verify:pilot",
    "verify": "npm run typecheck && npm run verify:guards"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}